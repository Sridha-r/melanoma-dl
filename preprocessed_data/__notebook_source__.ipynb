from sklearn.model_selection import GroupShuffleSplit

# First split: 70% train, 30% temporary
gss = GroupShuffleSplit(
    n_splits=1,
    test_size=0.30,
    random_state=42
)

train_idx, temp_idx = next(
    gss.split(
        train_df,
        train_df["target"],
        groups=train_df["patient_id"]
    )
)

train_df_split = train_df.iloc[train_idx].copy()
temp_df = train_df.iloc[temp_idx].copy()

# Second split: temporary -> 15% validation, 15% test
gss2 = GroupShuffleSplit(
    n_splits=1,
    test_size=0.50,
    random_state=42
)

val_idx, test_idx = next(
    gss2.split(
        temp_df,
        temp_df["target"],
        groups=temp_df["patient_id"]
    )
)

val_df = temp_df.iloc[val_idx].copy()
test_df = temp_df.iloc[test_idx].copy()

print("Train:", len(train_df_split))
print("Validation:", len(val_df))
print("Test:", len(test_df))


print(
