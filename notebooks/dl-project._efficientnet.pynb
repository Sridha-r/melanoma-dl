 int64\ntarget\n0    98.268455\n1     1.731545\nName: proportion, dtype: float64\n\nVALIDATION:\ntarget\n0    4830\n1      73\nName: count, dtype: int64\ntarget\n0    98.511116\n1     1.488884\nName: proportion, dtype: float64\n\nTEST:\ntarget\n0    5068\n1     112\nName: count, dtype: int64\ntarget\n0    97.837838\n1     2.162162\nName: proportion, dtype: float64\n","output_type":"stream"}],"execution_count":9},{"cell_type":"code","source":"import os\n\nIMAGE_PATH = DATA_PATH + \"/jpeg/train\"\n\ntrain_df_split[\"image_path\"] = train_df_split[\"image_name\"].apply(\n    lambda x: os.path.join(IMAGE_PATH, x + \".jpg\")\n)\n\nprint(\"Images found:\", train_df_split[\"image_path\"].apply(os.path.exists).sum())\nprint(\"Total training images:\", len(train_df_split))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T11:19:22.616277Z","iopub.execute_input":"2026-10-02T11:19:22.616752Z","iopub.status.idle":"2026-10-02T11:22:54.158378Z","shell.execute_reply.started":"2026-10-02T11:19:22.616722Z","shell.execute_reply":"2026-10-02T11:22:54.157683Z"}},"outputs":[{"name":"stdout","text":"Images found: 23043\nTotal training images: 23043\n","output_type":"stream"}],"execution_count":10},{"cell_type":"code","source":"from torchvision import transforms\n\ntrain_transform = transforms.Compose([\n    transforms.Resize((224, 224)),\n    transforms.RandomHorizontalFlip(),\n    transforms.RandomVerticalFlip(),\n    transforms.RandomRotation(20),\n    transforms.ToTensor(),\n    transforms.Normalize(\n        mean=[0.485, 0.456, 0.406],\n        std=[0.229, 0.224, 0.225]\n    )\n])\n\nval_test_transform = transforms.Compose([\n    transforms.Resize((224, 224)),\n    transforms.ToTensor(),\n    transforms.Normalize(\n        mean=[0.485, 0.456, 0.406],\n        std=[0.229, 0.224, 0.225]\n    )\n])\n\nprint(\"Transforms created successfully!\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T11:26:32.879193Z","iopub.execute_input":"2026-10-02T11:26:32.879743Z","iopub.status.idle":"2026-10-02T11:26:52.308904Z","shell.execute_reply.started":"2026-10-02T11:26:32.879711Z","shell.execute_reply":"2026-10-02T11:26:52.307856Z"}},"outputs":[{"name":"stdout","text":"Transforms created successfully!\n","output_type":"stream"}],"execution_count":11},{"cell_type":"code","source":"from torch.utils.data import Dataset\nfrom PIL import Image\nimport torch\n\nclass MelanomaDataset(Dataset):\n    def __init__(self, dataframe, transform=None):\n        self.dataframe = dataframe.reset_index(drop=True)\n        self.transform = transform\n\n    def __len__(self):\n        return len(self.dataframe)\n\n    def __getitem__(self, idx):\n        row = self.dataframe.iloc[idx]\n\n        image = Image.open(row[\"image_path\"]).convert(\"RGB\")\n        label = torch.tensor(row[\"target\"], dtype=torch.long)\n\n        if self.transform:\n            image = self.transform(image)\n\n        return image, label","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T11:27:31.348140Z","iopub.execute_input":"2026-10-02T11:27:31.348846Z","iopub.status.idle":"2026-10-02T11:27:31.354577Z","shell.execute_reply.started":"2026-10-02T11:27:31.348811Z","shell.execute_reply":"2026-10-02T11:27:31.353969Z"}},"outputs":[],"execution_count":14},{"cell_type":"code","source":"train_dataset = MelanomaDataset(\n    train_df_split,\n    transform=train_transform\n)\n\nval_dataset = MelanomaDataset(\n    val_df,\n    transform=val_test_transform\n)\n\ntest_dataset = MelanomaDataset(\n    test_df,\n    transform=val_test_transform\n)\n\nprint(\"Train dataset:\", len(train_dataset))\nprint(\"Validation dataset:\", len(val_dataset))\nprint(\"Test dataset:\", len(test_dataset))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T11:27:35.430918Z","iopub.execute_input":"2026-10-02T11:27:35.431427Z","iopub.status.idle":"2026-10-02T11:27:35.443987Z","shell.execute_reply.started":"2026-10-02T11:27:35.431397Z","shell.e