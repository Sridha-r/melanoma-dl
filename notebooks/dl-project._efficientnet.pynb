nprint(\"Non-melanoma:\", num_negative)\nprint(\"Melanoma:\", num_positive)\nprint(\"Positive class weight:\", pos_weight)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T11:33:55.171265Z","iopub.execute_input":"2026-10-02T11:33:55.171790Z","iopub.status.idle":"2026-10-02T11:33:55.178954Z","shell.execute_reply.started":"2026-10-02T11:33:55.171752Z","shell.execute_reply":"2026-10-02T11:33:55.178288Z"}},"outputs":[{"name":"stdout","text":"Non-melanoma: 22644\nMelanoma: 399\nPositive class weight: 56.75187969924812\n","output_type":"stream"}],"execution_count":23},{"cell_type":"code","source":"import torch.optim as optim\n\ncriterion = nn.BCEWithLogitsLoss(\n    pos_weight=torch.tensor([pos_weight], device=device)\n)\n\noptimizer = optim.AdamW(\n    model.parameters(),\n    lr=1e-4,\n    weight_decay=1e-4\n)\n\nprint(\"Loss and optimizer ready!\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T11:34:13.786109Z","iopub.execute_input":"2026-10-02T11:34:13.786718Z","iopub.status.idle":"2026-10-02T11:34:13.793087Z","shell.execute_reply.started":"2026-10-02T11:34:13.786678Z","shell.execute_reply":"2026-10-02T11:34:13.792244Z"}},"outputs":[{"name":"stdout","text":"Loss and optimizer ready!\n","output_type":"stream"}],"execution_count":24},{"cell_type":"code","source":"import os\nimport pandas as pd\n\nBASE = DATA_PATH\n\nprint(\"Files/folders in competition dataset:\\n\")\n\nfor root, dirs, files in os.walk(BASE):\n    level = root.replace(BASE, \"\").count(os.sep)\n    indent = \"  \" * level\n    print(f\"{indent}{os.path.basename(root)}/\")\n    \n    for f in files[:20]:\n        print(f\"{indent}  {f}\")\n    \n    if level >= 2:\n        dirs[:] = []\n\nprint(\"\\nCSV FILE CONTENTS:\\n\")\n\nfor csv_name in [\"train.csv\", \"test.csv\", \"sample_submission.csv\"]:\n    path = os.path.join(BASE, csv_name)\n    \n    if os.path.exists(path):\n        df = pd.read_csv(path)\n        print(f\"\\n--- {csv_name} ---\")\n    